# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/

# Environment variables (API keys etc.)
.env

# OS files
.DS_Store
Thumbs.db

# Data (raw/processed data can be large — not tracked in git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Streamlit secrets
.streamlit/secrets.toml

# IDE
.vscode/
.idea/

# Logs
*.log